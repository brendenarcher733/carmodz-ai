VITE_API_URL=http://localhost:8000

# Affiliate tracking on outbound shop links (components/ui/ShopLinks.jsx).
# Both optional — unset means today's plain (untracked) links, unchanged.
# Amazon Associates tag — get one at affiliate-program.amazon.com
VITE_AMAZON_ASSOCIATE_TAG=
# eBay Partner Network Campaign ID (10 digits) — get one at partnernetwork.ebay.com
VITE_EBAY_CAMPAIGN_ID=
